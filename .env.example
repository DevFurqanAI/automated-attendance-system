# ---------------------------------------------------------------------------
# Copy to .env.local and fill in from your Supabase project settings.
# On Vercel, set the same three variables in Project Settings → Environment
# Variables (or run `vercel env add`).
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → publishable (or legacy "anon") key.
# Safe to expose to the browser: every request it makes is subject to RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Supabase → Project Settings → API Keys → service_role (or secret) key.
# SERVER-ONLY. Bypasses Row-Level Security entirely.
# Never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Personal access token from https://supabase.com/dashboard/account/tokens
# SERVER-ONLY, and only needed by the scripts in scripts/ — `npm run db:apply`
# and `npm run auth:configure` talk to the Supabase Management API with it.
# The running app never reads it.
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# The public origin of the deployment, no trailing slash. Optional: only used
# as the default for `npm run auth:configure`, which can also take it as an
# argument. Nothing in the app reads it — emailed links come from Supabase's
# own site_url, which that script sets.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# In-app notifications always work. Email is off unless BOTH of these are set,
# so a half-configured environment quietly stays in-app rather than throwing on
# every approval. The transport in src/lib/notify.ts is a stub today.
# NOTIFY_EMAIL=on
# SMTP_URL=smtps://user:password@smtp.example.com:465

# ---------------------------------------------------------------------------
# QR signing
# ---------------------------------------------------------------------------
# There is deliberately NO app-wide QR signing secret. Each branch signs its own
# code with `branches.qr_secret`, generated by the database on insert, so one
# leaked code cannot forge the other branches and any single branch can be
# rotated on its own. See the header comment in src/lib/qr-token.ts.
